<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="paloma.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Maxon\Paloma">
    </Installer>
    <PackageInformation
        PackageName="Paloma"
        PackageDisplayName="Paloma"
        PublisherName="CN=Maxon"
        PublisherDisplayName="Maxon"
        Version="0.1.0.0"
        PackageDescription="Agent desktop companion">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.maxon.paloma"
                Description="Agent desktop companion"
                DisplayName="Paloma"
                ExecutableName="paloma.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Paloma</DisplayName>
            <PublisherDisplayName>Maxon</PublisherDisplayName>
            <Description>Agent desktop companion</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="paloma.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
